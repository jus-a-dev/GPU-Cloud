# Path to the kubeconfig on the host (mounted read-only into the container)
KUBECONFIG_PATH=~/.kube/config
# Namespace where notebooks are created
NAMESPACE=gpu-cloud
# Address users use to reach cluster nodes (shown in notebook URLs)
NODE_HOST=<node-ip-reachable-by-your-users>
PORT=8080
# Interface the UI listens on. 127.0.0.1 = local only. The API has no auth; only widen on a trusted network.
BIND=127.0.0.1
RUNTIME_CLASS=nvidia
